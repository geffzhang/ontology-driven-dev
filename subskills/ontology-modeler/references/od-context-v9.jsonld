    "type": "@type",
    "id": "@id",
    "od:sourceAggregate": {"@type": "@id"},
    "od:targetAggregate": {"@type": "@id"},
    "od:hasRole": {"@type": "@id"},
    "od:hasPermission": {"@type": "@id"},
    "od:hasItem": {"@type": "@id"},
    "od:objectRef": {"@type": "@id"},
