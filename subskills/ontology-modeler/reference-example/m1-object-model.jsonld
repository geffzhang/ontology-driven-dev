{
  "@context": {
    "@vocab": "https://ontology.ontology-driven.dev/v9#",
    "od": "https://ontology.ontology-driven.dev/v9#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "label": "rdfs:label",
    "type": "@type",
    "id": "@id"
  },
  "@graph": [
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-PRODUCT-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-PRODUCT-001",
      "od:name": "产品",
      "od:alias": "Product",
      "od:description": "产品主数据，本系统维护，被合同引用",
      "od:lifecycle": [
        "在用",
        "停用"
      ],
      "od:tags": [
        "主数据"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "productId",
          "od:label": "产品编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "productType",
          "od:label": "产品类型",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "productName",
          "od:label": "产品名称",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-CUSTOMER-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-CUSTOMER-001",
      "od:name": "客户",
      "od:alias": "Customer",
      "od:description": "客户主数据，本系统维护，被合同引用",
      "od:lifecycle": [
        "在用",
        "停用"
      ],
      "od:tags": [
        "主数据"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "customerId",
          "od:label": "客户编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "customerType",
          "od:label": "客户类型",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "customerName",
          "od:label": "客户名称",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-DEPARTMENT-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-DEPARTMENT-001",
      "od:name": "部门",
      "od:alias": "Department",
      "od:description": "组织主数据，本系统维护，被人员和合同引用",
      "od:lifecycle": [
        "在用",
        "停用"
      ],
      "od:tags": [
        "主数据"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "departmentId",
          "od:label": "部门编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "departmentName",
          "od:label": "部门名称",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-EMPLOYEE-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-EMPLOYEE-001",
      "od:name": "人员",
      "od:alias": "Employee",
      "od:description": "人员主数据，本系统维护，被合同责任人引用",
      "od:lifecycle": [
        "在用",
        "停用"
      ],
      "od:tags": [
        "主数据"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "employeeId",
          "od:label": "人员编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "employeeName",
          "od:label": "人员名称",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "departmentId",
          "od:label": "所属部门",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-CONTRACT-001",
      "od:name": "合同",
      "od:alias": "Contract",
      "od:description": "对外销售产生的合同签订信息，包含合同基本信息和付款条款明细",
      "od:lifecycle": [
        "草稿",
        "待财务经理审批",
        "待总经理审批",
        "已纳入管理",
        "已结清",
        "已驳回",
        "已作废",
        "已归档"
      ],
      "od:tags": [
        "核心域"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "contractNo",
          "od:label": "合同编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "contractName",
          "od:label": "合同名称",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "productId",
          "od:label": "所属产品",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "customerId",
          "od:label": "所属客户",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "departmentId",
          "od:label": "所属部门",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "contractType",
          "od:label": "合同类型",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "signDate",
          "od:label": "合同签订时间",
          "od:dataType": "Date",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "ownerId",
          "od:label": "责任人",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "totalAmount",
          "od:label": "合同总金额（含税）",
          "od:dataType": "Money",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "purchaseAmount",
          "od:label": "对外采购金额（含税）",
          "od:dataType": "Money",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "taxRate",
          "od:label": "合同税率",
          "od:dataType": "Decimal",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "status",
          "od:label": "登记管理状态",
          "od:dataType": "Enum",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "registeredAt",
          "od:label": "登记时间",
          "od:dataType": "DateTime",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "registrantId",
          "od:label": "登记人",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        }
      ],
      "od:hasEntity": [
        {
          "@type": "od:Entity",
          "od:name": "付款阶段",
          "od:alias": "PaymentStage",
          "od:localId": "stageId",
          "od:cardinality": "ONE_OR_MORE",
          "od:hasAttribute": [
            {
              "@type": "od:Attribute",
              "od:name": "stageId",
              "od:label": "付款阶段编号",
              "od:dataType": "String",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "stageName",
              "od:label": "付款阶段名称",
              "od:dataType": "String",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "payRatio",
              "od:label": "付款比例（百分比）",
              "od:dataType": "Decimal",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "stageAmount",
              "od:label": "阶段应付金额",
              "od:dataType": "Money",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "invoiceStatus",
              "od:label": "阶段开票状态",
              "od:dataType": "Enum",
              "od:required": true,
              "od:unique": false
            }
          ]
        }
      ],
      "od:hasInvariant": [
        {
          "@type": "od:Invariant",
          "od:name": "采购金额不超过合同金额",
          "od:expression": "purchaseAmount <= totalAmount",
          "od:violationMessage": "对外采购金额不得大于合同总金额",
          "od:enforcedAt": "ALWAYS"
        },
        {
          "@type": "od:Invariant",
          "od:name": "付款比例合计等于100",
          "od:expression": "SUM(stages.payRatio) == 100",
          "od:violationMessage": "付款阶段付款比例合计必须等于 100",
          "od:enforcedAt": "ON_CREATE"
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-INVOICE-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-INVOICE-001",
      "od:name": "开票",
      "od:alias": "Invoice",
      "od:description": "针对一个合同登记的开票业务记录，通过分摊关系覆盖一个或多个付款阶段",
      "od:lifecycle": [
        "草稿",
        "待财务经理审批",
        "已批准",
        "已驳回",
        "已作废"
      ],
      "od:tags": [
        "核心域"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "invoiceNo",
          "od:label": "开票编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "contractId",
          "od:label": "对应合同",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "invoiceAmount",
          "od:label": "开票金额（含税）",
          "od:dataType": "Money",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "invoiceTaxRate",
          "od:label": "开票税率",
          "od:dataType": "Decimal",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "invoiceDate",
          "od:label": "开票时间",
          "od:dataType": "Date",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receivedFlag",
          "od:label": "是否收款",
          "od:dataType": "Boolean",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receivedAmount",
          "od:label": "已收款金额",
          "od:dataType": "Money",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receivedDate",
          "od:label": "收款完成时间",
          "od:dataType": "DateTime",
          "od:required": false,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalStatus",
          "od:label": "开票审批状态",
          "od:dataType": "Enum",
          "od:required": true,
          "od:unique": false
        }
      ],
      "od:hasEntity": [
        {
          "@type": "od:Entity",
          "od:name": "开票付款阶段分摊",
          "od:alias": "InvoiceStageAllocation",
          "od:localId": "allocationId",
          "od:cardinality": "ONE_OR_MORE",
          "od:hasAttribute": [
            {
              "@type": "od:Attribute",
              "od:name": "allocationId",
              "od:label": "分摊标识",
              "od:dataType": "String",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "contractId",
              "od:label": "对应合同",
              "od:dataType": "AggregateRootRef",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "stageId",
              "od:label": "对应付款阶段",
              "od:dataType": "String",
              "od:required": true,
              "od:unique": false
            },
            {
              "@type": "od:Attribute",
              "od:name": "allocatedAmount",
              "od:label": "分摊金额",
              "od:dataType": "Money",
              "od:required": true,
              "od:unique": false
            }
          ]
        }
      ],
      "od:hasInvariant": [
        {
          "@type": "od:Invariant",
          "od:name": "开票分摊金额平衡",
          "od:expression": "SUM(allocations.allocatedAmount) == invoiceAmount",
          "od:violationMessage": "同一开票的分摊金额合计必须等于开票金额",
          "od:enforcedAt": "ALWAYS"
        },
        {
          "@type": "od:Invariant",
          "od:name": "已收款金额范围",
          "od:expression": "receivedAmount >= 0 AND receivedAmount <= invoiceAmount",
          "od:violationMessage": "已收款金额应在 0 到开票金额之间",
          "od:enforcedAt": "ALWAYS"
        },
        {
          "@type": "od:Invariant",
          "od:name": "收款完成信息一致",
          "od:expression": "IF receivedFlag == true THEN receivedAmount == invoiceAmount AND receivedDate != null",
          "od:violationMessage": "是否收款为是时，已收款金额须等于开票金额且完成时间非空",
          "od:enforcedAt": "ALWAYS"
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-RECEIPT-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-RECEIPT-001",
      "od:name": "收款",
      "od:alias": "Receipt",
      "od:description": "独立记录客户针对具体合同和开票的每笔收款",
      "od:lifecycle": [
        "已登记",
        "已冲销"
      ],
      "od:tags": [
        "核心域"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "receiptNo",
          "od:label": "收款编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "contractId",
          "od:label": "对应合同",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "invoiceId",
          "od:label": "对应开票",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receiptAmount",
          "od:label": "收款金额",
          "od:dataType": "Money",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receiptTime",
          "od:label": "收款时间",
          "od:dataType": "DateTime",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "receiptMethod",
          "od:label": "收款方式",
          "od:dataType": "DictionaryRef",
          "od:required": false,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "status",
          "od:label": "收款状态",
          "od:dataType": "Enum",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "remark",
          "od:label": "备注",
          "od:dataType": "String",
          "od:required": false,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:AGG-APPROVAL-001",
      "@type": "od:AggregateRoot",
      "od:id": "AGG-APPROVAL-001",
      "od:name": "审批记录",
      "od:alias": "ApprovalRecord",
      "od:description": "记录合同登记审批和开票审批的人工处理历史",
      "od:lifecycle": [
        "已记录"
      ],
      "od:tags": [
        "支撑域"
      ],
      "od:hasAttribute": [
        {
          "@type": "od:Attribute",
          "od:name": "approvalRecordNo",
          "od:label": "审批记录编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": true
        },
        {
          "@type": "od:Attribute",
          "od:name": "bizType",
          "od:label": "业务类型",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "bizNo",
          "od:label": "业务单据编号",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalNode",
          "od:label": "审批节点",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalRoleId",
          "od:label": "审批角色",
          "od:dataType": "String",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approverId",
          "od:label": "审批人员",
          "od:dataType": "AggregateRootRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalResult",
          "od:label": "审批结果",
          "od:dataType": "DictionaryRef",
          "od:required": true,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalComment",
          "od:label": "审批意见",
          "od:dataType": "String",
          "od:required": false,
          "od:unique": false
        },
        {
          "@type": "od:Attribute",
          "od:name": "approvalTime",
          "od:label": "审批时间",
          "od:dataType": "DateTime",
          "od:required": true,
          "od:unique": false
        }
      ]
    },
    {
      "@id": "urn:od:contract-mgmt:M1:ASSOC-CONTRACT-PRODUCT",
      "@type": "od:Association",
      "od:id": "ASSOC-CONTRACT-PRODUCT",
      "od:sourceAggregate": "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
      "od:targetAggregate": "urn:od:contract-mgmt:M1:AGG-PRODUCT-001",
      "od:associationType": "REFERENCE",
      "od:sourceRole": "所属产品",
      "od:targetRole": "产品合同",
      "od:cardinality": "MANY_TO_ONE",
      "od:referenceField": "productId"
    },
    {
      "@id": "urn:od:contract-mgmt:M1:ASSOC-CONTRACT-CUSTOMER",
      "@type": "od:Association",
      "od:id": "ASSOC-CONTRACT-CUSTOMER",
      "od:sourceAggregate": "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
      "od:targetAggregate": "urn:od:contract-mgmt:M1:AGG-CUSTOMER-001",
      "od:associationType": "REFERENCE",
      "od:sourceRole": "所属客户",
      "od:targetRole": "客户合同",
      "od:cardinality": "MANY_TO_ONE",
      "od:referenceField": "customerId"
    },
    {
      "@id": "urn:od:contract-mgmt:M1:ASSOC-CONTRACT-DEPARTMENT",
      "@type": "od:Association",
      "od:id": "ASSOC-CONTRACT-DEPARTMENT",
      "od:sourceAggregate": "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
