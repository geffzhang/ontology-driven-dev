<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B04> a meta:Step ;
    meta:dependsOn "B03" ;
    meta:id "B04" ;
    meta:kind "llm_classify" ;
    meta:label "审批结果判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B04-route-0>,
