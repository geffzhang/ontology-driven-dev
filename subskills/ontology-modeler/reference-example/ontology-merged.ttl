<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03> a meta:Step ;
    meta:dependsOn "P02" ;
    meta:id "P03" ;
    meta:kind "llm_classify" ;
    meta:label "财务审批结果判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03-route-1> .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03-route-0> a meta:Route ;
    meta:branchName "驳回" ;
    meta:choice "REJECT" ;
