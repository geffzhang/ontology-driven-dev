    meta:target "P08" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03-route-1> a meta:Route ;
    meta:branchName "通过" ;
    meta:choice "APPROVE" ;
    meta:conditionExpression "approval.outcome == 'APPROVE'" ;
    meta:isDefault true ;
    meta:target "P04" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04> a meta:Step ;
    meta:id "P04" ;
    meta:kind "llm_classify" ;
    meta:label "大额合同判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04-route-1> .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04-route-0> a meta:Route ;
    meta:branchName "金额大于等于100万元" ;
    meta:choice "RULE-CONTRACT-APPROVAL-LEVEL" ;
    meta:isDefault false ;
    meta:ruleRef "urn:od:contract-mgmt:M3:RULE-CONTRACT-APPROVAL-LEVEL" ;
    meta:target "P05" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04-route-1> a meta:Route ;
    meta:branchName "普通金额合同" ;
    meta:choice "普通金额合同" ;
    meta:isDefault true ;
    meta:target "P06" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P05> a meta:Step ;
    meta:enum "APPROVE",
        "REJECT" ;
    meta:id "P05" ;
    meta:kind "user_input" ;
    meta:label "总经理审批" ;
    meta:permissionRef "urn:od:contract-mgmt:M5:ROLE-GENERAL-MANAGER" ;
    meta:skill "urn:od:contract-mgmt:M2:Contract_ApproveGeneralManager" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P06> a meta:Step ;
    meta:dependsOn "P05" ;
    meta:id "P06" ;
    meta:kind "agent" ;
    meta:label "标记审批通过（合同已纳入管理）" ;
    meta:skill "urn:od:contract-mgmt:M2:Contract_ApproveGeneralManager" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P07> a meta:Step ;
    meta:dependsOn "P06" ;
    meta:id "P07" ;
    meta:kind "end" ;
    meta:label "审批通过结束" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P08> a meta:Step ;
    meta:id "P08" ;
    meta:kind "end" ;
    meta:label "驳回结束" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B01> a meta:Step ;
    meta:id "B01" ;
    meta:kind "start" ;
    meta:label "开始" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B02> a meta:Step ;
    meta:dependsOn "B01" ;
    meta:id "B02" ;
