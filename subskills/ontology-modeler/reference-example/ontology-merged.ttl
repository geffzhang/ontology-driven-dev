    meta:kind "llm_classify" ;
    meta:label "开票是否全部收齐" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B08-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B08-route-1> .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B08-route-0> a meta:Route ;
    meta:branchName "已全部收齐" ;
    meta:choice "RULE-INVOICE-RECEIPT-STATUS" ;
    meta:isDefault false ;
    meta:ruleRef "urn:od:contract-mgmt:M3:RULE-INVOICE-RECEIPT-STATUS" ;
    meta:target "B09" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B08-route-1> a meta:Route ;
    meta:branchName "未收齐，继续收款" ;
    meta:choice "未收齐，继续收款" ;
    meta:isDefault true ;
    meta:target "B06" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B09> a meta:Step ;
    meta:id "B09" ;
    meta:kind "end" ;
    meta:label "结束" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q01> a meta:Step ;
    meta:id "Q01" ;
    meta:kind "start" ;
    meta:label "开始" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q02> a meta:Step ;
    meta:dependsOn "Q01" ;
    meta:enum "APPROVE",
        "REJECT" ;
    meta:id "Q02" ;
    meta:kind "user_input" ;
    meta:label "财务经理审批" ;
    meta:permissionRef "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER" ;
    meta:skill "urn:od:contract-mgmt:M2:Invoice_ApproveFinance" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03> a meta:Step ;
    meta:dependsOn "Q02" ;
    meta:id "Q03" ;
    meta:kind "llm_classify" ;
    meta:label "审批结果判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03-route-1> .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03-route-0> a meta:Route ;
    meta:branchName "通过" ;
    meta:choice "APPROVE" ;
    meta:conditionExpression "approval.outcome == 'APPROVE'" ;
    meta:isDefault true ;
    meta:target "Q04" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03-route-1> a meta:Route ;
    meta:branchName "驳回" ;
    meta:choice "REJECT" ;
    meta:conditionExpression "approval.outcome == 'REJECT'" ;
    meta:isDefault false ;
    meta:target "Q05" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q04> a meta:Step ;
    meta:id "Q04" ;
    meta:kind "end" ;
    meta:label "审批通过结束（开票已批准）" .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q05> a meta:Step ;
    meta:id "Q05" ;
    meta:kind "end" ;
    meta:label "驳回结束" .

