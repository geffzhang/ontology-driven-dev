@prefix meta: <https://openclaw.dev/meta/v1#> .
@prefix od: <https://ontology.ontology-driven.dev/v9#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

od:RULE-ALLOCATION-CONTRACT-CONSISTENTShape a sh:NodeShape ;
    rdfs:comment "Rule: 分摊所属合同一致性. DSL: allocationContractId == invoiceContractId (pattern: degraded)" ;
    sh:message "判断分摊记录、开票和付款阶段是否属于同一合同" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "分摊所属合同一致性: requires valid invoiceContractId (String)" ;
            sh:minCount 1 ;
            sh:path od:invoiceContractId ],
        [ sh:datatype xsd:string ;
            sh:message "分摊所属合同一致性: requires valid allocationContractId (String)" ;
            sh:minCount 1 ;
            sh:path od:allocationContractId ] ;
    sh:severity sh:Violation .

od:RULE-APPROVAL-SODShape a sh:NodeShape ;
    rdfs:comment "Rule: 提交审批职责分离. DSL: approverId != submitterId (pattern: degraded)" ;
    sh:message "判断当前审批人是否不是该业务记录的提交人" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "提交审批职责分离: requires valid submitterId (String)" ;
            sh:minCount 1 ;
            sh:path od:submitterId ],
        [ sh:datatype xsd:string ;
            sh:message "提交审批职责分离: requires valid approverId (String)" ;
            sh:minCount 1 ;
            sh:path od:approverId ] ;
    sh:severity sh:Violation .

od:RULE-CONTRACT-APPROVAL-LEVELShape a sh:NodeShape ;
    rdfs:comment "Rule: 合同审批层级判定. DSL: totalAmount >= 1000000 (pattern: Pattern1-Simple)" ;
    sh:message "判断合同含税总金额是否大于等于 100 万元，决定是否需要总经理审批" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "合同审批层级判定: requires valid totalAmount (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:totalAmount ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
            SELECT ?this WHERE {
            ?this od:totalAmount ?totalAmount .
            FILTER (?totalAmount >= 1000000)
            }
        """ ] ;
    sh:targetClass od:Contract .

od:RULE-CONTRACT-INVOICE-ELIGIBLEShape a sh:NodeShape ;
    rdfs:comment "Rule: 合同可开票资格. DSL: contractStatus == '已纳入管理' OR contractStatus == '已结清' (pattern: Pattern3-OR-chain)" ;
    sh:message "判断合同是否已纳入管理且未作废、未归档，从而允许开票" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "合同可开票资格: requires valid contractStatus (Enum)" ;
            sh:minCount 1 ;
            sh:path od:contractStatus ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
            SELECT ?this WHERE {
            ?this od:contractStatus ?contractStatus .
            FILTER (!(?contractStatus = "已纳入管理" || ?contractStatus = "已结清"))
            }
        """ ] ;
    sh:targetClass od:Contract .

od:RULE-CONTRACT-SETTLEMENTShape a sh:NodeShape ;
    rdfs:comment "Rule: 合同结清资格判定. DSL: allStagesFullyInvoiced == true AND allInvoicesFullyReceived == true (pattern: degraded)" ;
    sh:message "判断所有付款阶段是否均已足额开票，且所有已批准未作废开票均已全部收齐" ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:message "合同结清资格判定: requires valid allInvoicesFullyReceived (Boolean)" ;
            sh:minCount 1 ;
            sh:path od:allInvoicesFullyReceived ],
        [ sh:datatype xsd:boolean ;
            sh:message "合同结清资格判定: requires valid allStagesFullyInvoiced (Boolean)" ;
            sh:minCount 1 ;
            sh:path od:allStagesFullyInvoiced ] ;
    sh:severity sh:Violation .

od:RULE-CONTRACT-VOID-ELIGIBLEShape a sh:NodeShape ;
    rdfs:comment "Rule: 合同作废资格. DSL: approvedInvoiceCount == 0 AND validReceiptCount == 0 (pattern: degraded)" ;
    sh:message "判断是否不存在已批准开票或有效收款，从而允许作废合同" ;
    sh:property [ sh:datatype xsd:integer ;
            sh:message "合同作废资格: requires valid validReceiptCount (Integer)" ;
            sh:minCount 1 ;
            sh:path od:validReceiptCount ],
        [ sh:datatype xsd:integer ;
            sh:message "合同作废资格: requires valid approvedInvoiceCount (Integer)" ;
            sh:minCount 1 ;
            sh:path od:approvedInvoiceCount ] ;
    sh:severity sh:Violation .

od:RULE-INVOICE-RECEIPT-STATUSShape a sh:NodeShape ;
    rdfs:comment "Rule: 开票收款状态判定. DSL: IF receivedAmount <= 0 THEN '未收款' ELSE IF receivedAmount >= invoiceAmount THEN '已收款' ELSE '部分收款' (pattern: degraded)" ;
    sh:message "根据有效收款累计相对开票金额判定开票处于未收款、部分收款或全部收齐" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "开票收款状态判定: requires valid receivedAmount (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:receivedAmount ],
        [ sh:datatype xsd:decimal ;
            sh:message "开票收款状态判定: requires valid invoiceAmount (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:invoiceAmount ] ;
    sh:severity sh:Violation .

od:RULE-INVOICE-REMAIN-RECEIPT-QUOTAShape a sh:NodeShape ;
    rdfs:comment "Rule: 开票剩余可收款额度. DSL: historicalReceipt + currentReceipt <= invoiceAmount (pattern: degraded)" ;
    sh:message "判断本次收款加历史有效收款是否不超过开票金额" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "开票剩余可收款额度: requires valid currentReceipt (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:currentReceipt ],
        [ sh:datatype xsd:decimal ;
            sh:message "开票剩余可收款额度: requires valid historicalReceipt (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:historicalReceipt ],
        [ sh:datatype xsd:decimal ;
            sh:message "开票剩余可收款额度: requires valid invoiceAmount (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:invoiceAmount ] ;
    sh:severity sh:Violation .

od:RULE-INVOICE-TAXRATE-CONSISTENTShape a sh:NodeShape ;
    rdfs:comment "Rule: 开票税率一致性. DSL: invoiceTaxRate == contractTaxRate (pattern: degraded)" ;
    sh:message "判断开票税率是否等于合同税率" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "开票税率一致性: requires valid invoiceTaxRate (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:invoiceTaxRate ],
        [ sh:datatype xsd:decimal ;
            sh:message "开票税率一致性: requires valid contractTaxRate (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:contractTaxRate ] ;
    sh:severity sh:Violation .

od:RULE-INVOICE-VOID-ELIGIBLEShape a sh:NodeShape ;
    rdfs:comment "Rule: 开票作废资格. DSL: validReceiptCount == 0 (pattern: Pattern1-Simple)" ;
    sh:message "判断开票是否存在有效收款，从而允许作废" ;
    sh:property [ sh:datatype xsd:integer ;
            sh:message "开票作废资格: requires valid validReceiptCount (Integer)" ;
            sh:minCount 1 ;
            sh:path od:validReceiptCount ] ;
    sh:severity sh:Violation ;
    sh:sparql [ sh:select """
            SELECT ?this WHERE {
            ?this od:validReceiptCount ?validReceiptCount .
            FILTER (?validReceiptCount = 0)
            }
        """ ] ;
    sh:targetClass od:Receipt .

od:RULE-OWNER-DEPT-CONSISTENTShape a sh:NodeShape ;
    rdfs:comment "Rule: 责任人部门一致性. DSL: ownerDepartmentId == contractDepartmentId (pattern: degraded)" ;
    sh:message "判断责任人所属部门是否等于合同所属部门" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "责任人部门一致性: requires valid contractDepartmentId (String)" ;
            sh:minCount 1 ;
            sh:path od:contractDepartmentId ],
        [ sh:datatype xsd:string ;
            sh:message "责任人部门一致性: requires valid ownerDepartmentId (String)" ;
            sh:minCount 1 ;
            sh:path od:ownerDepartmentId ] ;
    sh:severity sh:Violation .

od:RULE-PAYSTAGE-REMAIN-QUOTAShape a sh:NodeShape ;
    rdfs:comment "Rule: 付款阶段剩余可开票额度. DSL: historicalAllocation + currentAllocation <= stageAmount (pattern: degraded)" ;
    sh:message "判断本次分摊加历史有效分摊是否不超过阶段应付金额" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "付款阶段剩余可开票额度: requires valid historicalAllocation (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:historicalAllocation ],
        [ sh:datatype xsd:decimal ;
            sh:message "付款阶段剩余可开票额度: requires valid currentAllocation (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:currentAllocation ],
        [ sh:datatype xsd:decimal ;
            sh:message "付款阶段剩余可开票额度: requires valid stageAmount (Decimal)" ;
            sh:minCount 1 ;
            sh:path od:stageAmount ] ;
    sh:severity sh:Violation .

od:RULE-RECEIPT-CONTRACT-CONSISTENTShape a sh:NodeShape ;
    rdfs:comment "Rule: 收款所属合同一致性. DSL: receiptContractId == invoiceContractId (pattern: degraded)" ;
    sh:message "判断收款所选合同是否等于对应开票所属合同" ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "收款所属合同一致性: requires valid receiptContractId (String)" ;
            sh:minCount 1 ;
            sh:path od:receiptContractId ],
        [ sh:datatype xsd:string ;
            sh:message "收款所属合同一致性: requires valid invoiceContractId (String)" ;
            sh:minCount 1 ;
            sh:path od:invoiceContractId ] ;
    sh:severity sh:Violation .

<urn:od:contract-mgmt:M1:AGG-APPROVAL-001> a od:AggregateRoot ;
    od:alias "ApprovalRecord" ;
    od:description "记录合同登记审批和开票审批的人工处理历史" ;
    od:hasAttribute [ a od:Attribute ;
            od:dataType "String" ;
            od:label "审批记录编号" ;
            od:name "approvalRecordNo" ;
            od:required true ;
            od:unique true ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "审批意见" ;
            od:name "approvalComment" ;
            od:required false ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DictionaryRef" ;
            od:dictionaryRef [ od:dictionaryId "DICT-BIZ-TYPE" ;
                    od:typeCode "BIZ_TYPE" ] ;
            od:label "业务类型" ;
            od:name "bizType" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "审批人员" ;
            od:name "approverId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DictionaryRef" ;
            od:dictionaryRef [ od:dictionaryId "DICT-APPROVAL-NODE" ;
                    od:typeCode "APPROVAL_NODE" ] ;
            od:label "审批节点" ;
            od:name "approvalNode" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "审批角色" ;
            od:name "approvalRoleId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DateTime" ;
            od:label "审批时间" ;
            od:name "approvalTime" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "业务单据编号" ;
            od:name "bizNo" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DictionaryRef" ;
            od:dictionaryRef [ od:dictionaryId "DICT-APPROVAL-RESULT" ;
                    od:typeCode "APPROVAL_RESULT" ] ;
            od:label "审批结果" ;
            od:name "approvalResult" ;
            od:required true ;
            od:unique false ] ;
    od:id "AGG-APPROVAL-001" ;
    od:lifecycle "已记录" ;
    od:name "审批记录" ;
    od:tags "支撑域" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-CUSTOMER> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "MANY_TO_ONE" ;
    od:id "ASSOC-CONTRACT-CUSTOMER" ;
    od:referenceField "customerId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "所属客户" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-CUSTOMER-001> ;
    od:targetRole "客户合同" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-DEPARTMENT> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "MANY_TO_ONE" ;
    od:id "ASSOC-CONTRACT-DEPARTMENT" ;
    od:referenceField "departmentId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "归属部门" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-DEPARTMENT-001> ;
    od:targetRole "部门合同" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-EMPLOYEE> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "MANY_TO_ONE" ;
    od:id "ASSOC-CONTRACT-EMPLOYEE" ;
    od:referenceField "ownerId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "责任人" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-EMPLOYEE-001> ;
    od:targetRole "负责合同" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-INVOICE> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "ONE_TO_MANY" ;
    od:id "ASSOC-CONTRACT-INVOICE" ;
    od:referenceField "contractId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "产生开票" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-INVOICE-001> ;
    od:targetRole "所属合同" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-PRODUCT> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "MANY_TO_ONE" ;
    od:id "ASSOC-CONTRACT-PRODUCT" ;
    od:referenceField "productId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "所属产品" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-PRODUCT-001> ;
    od:targetRole "产品合同" .

<urn:od:contract-mgmt:M1:ASSOC-CONTRACT-RECEIPT> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "ONE_TO_MANY" ;
    od:id "ASSOC-CONTRACT-RECEIPT" ;
    od:referenceField "contractId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
    od:sourceRole "对应收款" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-RECEIPT-001> ;
    od:targetRole "所属合同" .

<urn:od:contract-mgmt:M1:ASSOC-DEPARTMENT-EMPLOYEE> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "MANY_TO_ONE" ;
    od:id "ASSOC-DEPARTMENT-EMPLOYEE" ;
    od:referenceField "departmentId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-EMPLOYEE-001> ;
    od:sourceRole "所属部门" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-DEPARTMENT-001> ;
    od:targetRole "部门人员" .

<urn:od:contract-mgmt:M1:ASSOC-INVOICE-RECEIPT> a od:Association ;
    od:associationType "REFERENCE" ;
    od:cardinality "ONE_TO_MANY" ;
    od:id "ASSOC-INVOICE-RECEIPT" ;
    od:referenceField "invoiceId" ;
    od:sourceAggregate <urn:od:contract-mgmt:M1:AGG-INVOICE-001> ;
    od:sourceRole "对应收款" ;
    od:targetAggregate <urn:od:contract-mgmt:M1:AGG-RECEIPT-001> ;
    od:targetRole "所属开票" .

<urn:od:contract-mgmt:M1:DICT-APPROVAL-NODE> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:hasItem <urn:od:contract-mgmt:M1:APPROVAL_NODE:FINANCE_MANAGER>,
                <urn:od:contract-mgmt:M1:APPROVAL_NODE:GENERAL_MANAGER> ;
            od:typeCode "APPROVAL_NODE" ;
            od:typeName "审批节点" ] ;
    od:id "DICT-APPROVAL-NODE" ;
    od:name "审批节点字典" .

<urn:od:contract-mgmt:M1:DICT-APPROVAL-RESULT> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:hasItem <urn:od:contract-mgmt:M1:APPROVAL_RESULT:APPROVE>,
                <urn:od:contract-mgmt:M1:APPROVAL_RESULT:REJECT> ;
            od:typeCode "APPROVAL_RESULT" ;
            od:typeName "审批结果" ] ;
    od:id "DICT-APPROVAL-RESULT" ;
    od:name "审批结果字典" .

<urn:od:contract-mgmt:M1:DICT-BIZ-TYPE> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:hasItem <urn:od:contract-mgmt:M1:BIZ_TYPE:CONTRACT_REG>,
                <urn:od:contract-mgmt:M1:BIZ_TYPE:INVOICE> ;
            od:typeCode "BIZ_TYPE" ;
            od:typeName "业务类型" ] ;
    od:id "DICT-BIZ-TYPE" ;
    od:name "审批业务类型字典" .

<urn:od:contract-mgmt:M1:DICT-CONTRACT-TYPE> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:hasItem <urn:od:contract-mgmt:M1:CONTRACT_TYPE:INTEGRATION>,
                <urn:od:contract-mgmt:M1:CONTRACT_TYPE:PRODUCT>,
                <urn:od:contract-mgmt:M1:CONTRACT_TYPE:SERVICE> ;
            od:typeCode "CONTRACT_TYPE" ;
            od:typeName "合同类型" ] ;
    od:id "DICT-CONTRACT-TYPE" ;
    od:name "合同类型字典" .

<urn:od:contract-mgmt:M1:DICT-CUSTOMER-TYPE> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:typeCode "CUSTOMER_TYPE" ;
            od:typeName "客户类型" ] ;
    od:id "DICT-CUSTOMER-TYPE" ;
    od:name "客户类型字典" .

<urn:od:contract-mgmt:M1:DICT-PRODUCT-TYPE> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:typeCode "PRODUCT_TYPE" ;
            od:typeName "产品类型" ] ;
    od:id "DICT-PRODUCT-TYPE" ;
    od:name "产品类型字典" .

<urn:od:contract-mgmt:M1:DICT-RECEIPT-METHOD> a od:DataDictionary ;
    od:hasType [ a od:DictionaryType ;
            od:hasItem <urn:od:contract-mgmt:M1:RECEIPT_METHOD:BANK>,
                <urn:od:contract-mgmt:M1:RECEIPT_METHOD:BILL>,
                <urn:od:contract-mgmt:M1:RECEIPT_METHOD:OTHER> ;
            od:typeCode "RECEIPT_METHOD" ;
            od:typeName "收款方式" ] ;
    od:id "DICT-RECEIPT-METHOD" ;
    od:name "收款方式字典" .

