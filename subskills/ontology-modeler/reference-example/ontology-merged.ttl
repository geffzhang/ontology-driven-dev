<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A01> a meta:Step ;
    meta:id "A01" ;
    meta:kind "start" ;
    meta:label "开始" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A02> a meta:Step ;
    meta:dependsOn "A01" ;
    meta:id "A02" ;
    meta:kind "user_input" ;
    meta:label "创建合同（保存草稿/提交审批）" ;
    meta:permissionRef "urn:od:contract-mgmt:M5:ROLE-SALES" ;
    meta:skill "urn:od:contract-mgmt:M2:Contract_Submit" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A03> a meta:Step ;
    meta:dependsOn "A02" ;
    meta:id "A03" ;
    meta:kind "skill_exec" ;
    meta:label "合同登记审批" ;
    meta:skill "urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04> a meta:Step ;
    meta:dependsOn "A03" ;
    meta:id "A04" ;
    meta:kind "llm_classify" ;
    meta:label "审批结果判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-1>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-2> .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-0> a meta:Route ;
    meta:branchName "审批通过" ;
    meta:choice "APPROVE" ;
    meta:conditionExpression "approval.outcome == 'APPROVE'" ;
    meta:isDefault true ;
    meta:target "A05" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-1> a meta:Route ;
    meta:branchName "驳回后修改重提" ;
    meta:choice "REJECT" ;
    meta:conditionExpression "approval.outcome == 'REJECT'" ;
    meta:isDefault false ;
    meta:target "A02" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04-route-2> a meta:Route ;
    meta:branchName "终止且不再提交" ;
    meta:choice "TERMINATE" ;
    meta:conditionExpression "approval.outcome == 'TERMINATE'" ;
    meta:isDefault false ;
    meta:target "A09" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A05> a meta:Step ;
    meta:id "A05" ;
    meta:kind "skill_exec" ;
    meta:label "开票与收款循环" ;
    meta:skill "urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06> a meta:Step ;
    meta:dependsOn "A05" ;
    meta:id "A06" ;
    meta:kind "llm_classify" ;
    meta:label "合同结清判断" ;
    meta:routes <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06-route-0>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06-route-1> .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06-route-0> a meta:Route ;
    meta:branchName "满足结清条件" ;
    meta:choice "RULE-CONTRACT-SETTLEMENT" ;
    meta:isDefault false ;
    meta:ruleRef "urn:od:contract-mgmt:M3:RULE-CONTRACT-SETTLEMENT" ;
    meta:target "A07" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06-route-1> a meta:Route ;
    meta:branchName "未结清，继续开票收款" ;
    meta:choice "未结清，继续开票收款" ;
    meta:isDefault true ;
    meta:target "A05" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A07> a meta:Step ;
    meta:id "A07" ;
    meta:kind "agent" ;
    meta:label "合同结清（由同步联动自动触发）" ;
    meta:skill "urn:od:contract-mgmt:M2:Contract_UpdateSettlementStatus" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A08> a meta:Step ;
    meta:dependsOn "A07" ;
    meta:id "A08" ;
    meta:kind "user_input" ;
    meta:label "合同作废或归档" ;
    meta:permissionRef "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER" ;
    meta:skill "urn:od:contract-mgmt:M2:Contract_VoidOrArchive" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A09> a meta:Step ;
    meta:dependsOn "A08" ;
    meta:id "A09" ;
    meta:kind "end" ;
    meta:label "结束" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P01> a meta:Step ;
    meta:id "P01" ;
    meta:kind "start" ;
    meta:label "开始" .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P02> a meta:Step ;
    meta:dependsOn "P01" ;
    meta:enum "APPROVE",
        "REJECT" ;
    meta:id "P02" ;
    meta:kind "user_input" ;
    meta:label "财务经理审批" ;
    meta:permissionRef "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER" ;
