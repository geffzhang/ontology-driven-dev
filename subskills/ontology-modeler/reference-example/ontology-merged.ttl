<urn:od:contract-mgmt:M6:FLOW-CONTRACT-001> a meta:Flow ;
    meta:businessObjectRefs "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
        "urn:od:contract-mgmt:M1:AGG-INVOICE-001",
        "urn:od:contract-mgmt:M1:AGG-RECEIPT-001" ;
    meta:description "从合同创建、审批、生效、开票和收款到合同关闭的端到端协同流程" ;
    meta:flowType "COLLABORATION" ;
    meta:hasStep <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A01>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A02>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A03>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A04>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A05>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A06>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A07>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A08>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-001:A09> ;
    meta:id "FLOW-CONTRACT-001" ;
    meta:name "合同全生命周期流程" ;
    meta:postconditions "合同已归档或流程已明确终止" ;
    meta:preconditions "销售合同已完成线下签字盖章，具备登记条件" ;
    meta:roleRefs "urn:od:contract-mgmt:M5:ROLE-FINANCE",
        "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER",
        "urn:od:contract-mgmt:M5:ROLE-GENERAL-MANAGER",
        "urn:od:contract-mgmt:M5:ROLE-SALES" ;
    meta:startActivity "A01" ;
    meta:trigger [ meta:triggerType "MANUAL" ] .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001> a meta:Flow ;
    meta:businessObjectRefs "urn:od:contract-mgmt:M1:AGG-CONTRACT-001" ;
    meta:description "合同先由财务经理审批，金额大于等于100万元时增加总经理审批" ;
    meta:flowType "APPROVAL" ;
    meta:hasStep <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P01>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P02>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P03>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P04>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P05>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P06>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P07>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-APPROVAL-001:P08> ;
    meta:id "FLOW-CONTRACT-APPROVAL-001" ;
    meta:name "合同登记审批" ;
    meta:postconditions "合同审批通过、驳回或终止" ;
    meta:preconditions "contract.status == '待财务经理审批'" ;
    meta:roleRefs "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER",
        "urn:od:contract-mgmt:M5:ROLE-GENERAL-MANAGER" ;
    meta:startActivity "P01" ;
    meta:trigger [ meta:behaviorRef "Contract_Submit" ;
            meta:triggerType "BEHAVIOR" ] .

<urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002> a meta:Flow ;
    meta:businessObjectRefs "urn:od:contract-mgmt:M1:AGG-CONTRACT-001",
        "urn:od:contract-mgmt:M1:AGG-INVOICE-001",
        "urn:od:contract-mgmt:M1:AGG-RECEIPT-001" ;
    meta:description "根据客户付款通知完成开票审批、付款阶段占用、收款登记和状态联动" ;
    meta:flowType "COLLABORATION" ;
    meta:hasStep <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B01>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B02>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B03>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B04>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B05>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B06>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B07>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B08>,
        <urn:od:contract-mgmt:M6:FLOW-CONTRACT-INVOICE-002:B09> ;
    meta:id "FLOW-CONTRACT-INVOICE-002" ;
    meta:name "合同开票与收款流程" ;
    meta:postconditions "本次有效开票已全部收齐，或开票审批终止/开票作废" ;
    meta:preconditions "合同已纳入管理且客户已发出付款通知" ;
    meta:roleRefs "urn:od:contract-mgmt:M5:ROLE-FINANCE",
        "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER" ;
    meta:startActivity "B01" ;
    meta:trigger [ meta:triggerType "MANUAL" ] .

<urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002> a meta:Flow ;
    meta:businessObjectRefs "urn:od:contract-mgmt:M1:AGG-INVOICE-001" ;
    meta:description "开票由财务经理单节点审批" ;
    meta:flowType "APPROVAL" ;
    meta:hasStep <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q01>,
        <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q02>,
        <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q03>,
        <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q04>,
        <urn:od:contract-mgmt:M6:FLOW-INVOICE-APPROVAL-002:Q05> ;
    meta:id "FLOW-INVOICE-APPROVAL-002" ;
    meta:name "开票审批" ;
    meta:postconditions "开票审批通过、驳回或终止" ;
    meta:preconditions "invoice.approvalStatus == '待财务经理审批'" ;
    meta:roleRefs "urn:od:contract-mgmt:M5:ROLE-FINANCE-MANAGER" ;
    meta:startActivity "Q01" ;
    meta:trigger [ meta:behaviorRef "Invoice_Submit" ;
            meta:triggerType "BEHAVIOR" ] .

<urn:od:contract-mgmt:M7:REP-CONTRACT-DETAIL> a od:Report ;
    od:alias "contractDetail" ;
    od:boundBehavior <urn:od:contract-mgmt:M2:Contract_QueryDetail> ;
    od:description "查看单个合同的完整执行信息和可追溯历史" ;
    od:id "REP-CONTRACT-DETAIL" ;
    od:name "合同详情查询" ;
    od:objectType "DETAIL_QUERY" ;
    od:sourceObject [ a od:SourceObject ;
            od:alias "contract" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
            od:primary true ] .

<urn:od:contract-mgmt:M7:REP-CONTRACT-EXECUTION> a od:Report ;
    od:alias "contractExecutionAnalysis" ;
    od:boundBehavior <urn:od:contract-mgmt:M2:Contract_QueryExecutionAnalysis> ;
    od:description "按合同汇总收款进度，识别合同执行与回款情况" ;
    od:id "REP-CONTRACT-EXECUTION" ;
    od:name "合同执行情况分析" ;
    od:objectType "STATISTICAL_QUERY" ;
    od:sourceObject [ a od:SourceObject ;
            od:alias "receiptAgg" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-RECEIPT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "contract" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
            od:primary true ],
        [ a od:SourceObject ;
            od:alias "invoiceAgg" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-INVOICE-001> ;
            od:primary false ] .

<urn:od:contract-mgmt:M7:REP-CONTRACT-LIST> a od:Report ;
    od:alias "contractList" ;
    od:boundBehavior <urn:od:contract-mgmt:M2:Contract_QueryList> ;
    od:description "按多种业务条件模糊查找合同并进入合同详情" ;
    od:id "REP-CONTRACT-LIST" ;
    od:name "合同综合查询" ;
    od:objectType "LIST_QUERY" ;
    od:sourceObject [ a od:SourceObject ;
            od:alias "department" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-DEPARTMENT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "product" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-PRODUCT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "customer" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CUSTOMER-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "contract" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
            od:primary true ],
        [ a od:SourceObject ;
            od:alias "employee" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-EMPLOYEE-001> ;
            od:primary false ] .

<urn:od:contract-mgmt:M7:REP-DEPT-CONTRACT-SUMMARY> a od:Report ;
    od:alias "departmentContractSummary" ;
    od:boundBehavior <urn:od:contract-mgmt:M2:Contract_QueryDepartmentSummary> ;
    od:description "按部门汇总合同规模、开票和回款执行情况" ;
    od:id "REP-DEPT-CONTRACT-SUMMARY" ;
    od:name "部门合同统计分析报表" ;
    od:objectType "REPORT" ;
    od:sourceObject [ a od:SourceObject ;
            od:alias "receiptAgg" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-RECEIPT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "department" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-DEPARTMENT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "contract" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
            od:primary true ],
        [ a od:SourceObject ;
            od:alias "invoiceAgg" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-INVOICE-001> ;
            od:primary false ] .

<urn:od:contract-mgmt:M7:REP-INVOICED-UNRECEIVED> a od:Report ;
    od:alias "invoicedUnreceivedContracts" ;
    od:boundBehavior <urn:od:contract-mgmt:M2:Contract_QueryInvoicedUnreceived> ;
    od:description "识别已批准开票但尚未全部收款的合同和开票记录（欠款清单）" ;
    od:id "REP-INVOICED-UNRECEIVED" ;
    od:name "已开票未收款合同分析" ;
    od:objectType "STATISTICAL_QUERY" ;
    od:sourceObject [ a od:SourceObject ;
            od:alias "receiptAgg" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-RECEIPT-001> ;
            od:primary false ],
        [ a od:SourceObject ;
            od:alias "invoice" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-INVOICE-001> ;
            od:primary true ],
        [ a od:SourceObject ;
            od:alias "contract" ;
            od:objectRef <urn:od:contract-mgmt:M1:AGG-CONTRACT-001> ;
            od:primary false ] .

