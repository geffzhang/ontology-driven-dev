<urn:od:contract-mgmt:M1:AGG-INVOICE-001> a od:AggregateRoot ;
    od:alias "Invoice" ;
    od:description "针对一个合同登记的开票业务记录，通过分摊关系覆盖一个或多个付款阶段" ;
    od:hasAttribute [ a od:Attribute ;
            od:dataType "DateTime" ;
            od:label "收款完成时间" ;
            od:name "receivedDate" ;
            od:required false ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Boolean" ;
            od:label "是否收款" ;
            od:name "receivedFlag" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Date" ;
            od:label "开票时间" ;
            od:name "invoiceDate" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "对应合同" ;
            od:name "contractId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Enum" ;
            od:label "开票审批状态" ;
            od:name "approvalStatus" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "开票编号" ;
            od:name "invoiceNo" ;
            od:required true ;
            od:unique true ],
        [ a od:Attribute ;
            od:dataType "Money" ;
            od:label "已收款金额" ;
            od:name "receivedAmount" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Decimal" ;
            od:label "开票税率" ;
            od:name "invoiceTaxRate" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Money" ;
            od:label "开票金额（含税）" ;
            od:name "invoiceAmount" ;
            od:required true ;
            od:unique false ] ;
    od:hasEntity [ a od:Entity ;
            od:alias "InvoiceStageAllocation" ;
            od:cardinality "ONE_OR_MORE" ;
            od:hasAttribute [ a od:Attribute ;
                    od:dataType "String" ;
                    od:label "对应付款阶段" ;
                    od:name "stageId" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "AggregateRootRef" ;
                    od:label "对应合同" ;
                    od:name "contractId" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "Money" ;
                    od:label "分摊金额" ;
                    od:name "allocatedAmount" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "String" ;
                    od:label "分摊标识" ;
                    od:name "allocationId" ;
                    od:required true ;
                    od:unique false ] ;
            od:localId "allocationId" ;
            od:name "开票付款阶段分摊" ] ;
    od:hasInvariant [ a od:Invariant ;
            od:enforcedAt "ALWAYS" ;
            od:expression "receivedAmount >= 0 AND receivedAmount <= invoiceAmount" ;
            od:name "已收款金额范围" ;
            od:violationMessage "已收款金额应在 0 到开票金额之间" ],
        [ a od:Invariant ;
            od:enforcedAt "ALWAYS" ;
            od:expression "SUM(allocations.allocatedAmount) == invoiceAmount" ;
            od:name "开票分摊金额平衡" ;
            od:violationMessage "同一开票的分摊金额合计必须等于开票金额" ],
        [ a od:Invariant ;
            od:enforcedAt "ALWAYS" ;
            od:expression "IF receivedFlag == true THEN receivedAmount == invoiceAmount AND receivedDate != null" ;
            od:name "收款完成信息一致" ;
            od:violationMessage "是否收款为是时，已收款金额须等于开票金额且完成时间非空" ] ;
    od:id "AGG-INVOICE-001" ;
    od:lifecycle "已作废",
        "已批准",
        "已驳回",
        "待财务经理审批",
        "草稿" ;
    od:name "开票" ;
    od:tags "核心域" .

<urn:od:contract-mgmt:M1:AGG-RECEIPT-001> a od:AggregateRoot ;
    od:alias "Receipt" ;
    od:description "独立记录客户针对具体合同和开票的每笔收款" ;
    od:hasAttribute [ a od:Attribute ;
            od:dataType "DateTime" ;
            od:label "收款时间" ;
            od:name "receiptTime" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "备注" ;
            od:name "remark" ;
            od:required false ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DictionaryRef" ;
            od:dictionaryRef [ od:dictionaryId "DICT-RECEIPT-METHOD" ;
                    od:typeCode "RECEIPT_METHOD" ] ;
            od:label "收款方式" ;
            od:name "receiptMethod" ;
            od:required false ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "对应合同" ;
            od:name "contractId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "对应开票" ;
            od:name "invoiceId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Money" ;
            od:label "收款金额" ;
            od:name "receiptAmount" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "收款编号" ;
            od:name "receiptNo" ;
            od:required true ;
            od:unique true ],
        [ a od:Attribute ;
            od:dataType "Enum" ;
            od:label "收款状态" ;
            od:name "status" ;
            od:required true ;
            od:unique false ] ;
    od:id "AGG-RECEIPT-001" ;
    od:lifecycle "已冲销",
        "已登记" ;
    od:name "收款" ;
    od:tags "核心域" .

<urn:od:contract-mgmt:M1:AGG-CONTRACT-001> a od:AggregateRoot ;
    od:alias "Contract" ;
    od:description "对外销售产生的合同签订信息，包含合同基本信息和付款条款明细" ;
    od:hasAttribute [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "责任人" ;
            od:name "ownerId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "登记人" ;
            od:name "registrantId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "合同名称" ;
            od:name "contractName" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DictionaryRef" ;
            od:dictionaryRef [ od:dictionaryId "DICT-CONTRACT-TYPE" ;
                    od:typeCode "CONTRACT_TYPE" ] ;
            od:label "合同类型" ;
            od:name "contractType" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Date" ;
            od:label "合同签订时间" ;
            od:name "signDate" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "所属客户" ;
            od:name "customerId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "所属部门" ;
            od:name "departmentId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Money" ;
            od:label "合同总金额（含税）" ;
            od:name "totalAmount" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "String" ;
            od:label "合同编号" ;
            od:name "contractNo" ;
            od:required true ;
            od:unique true ],
        [ a od:Attribute ;
            od:dataType "Decimal" ;
            od:label "合同税率" ;
            od:name "taxRate" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "DateTime" ;
            od:label "登记时间" ;
            od:name "registeredAt" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "AggregateRootRef" ;
            od:label "所属产品" ;
            od:name "productId" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Money" ;
            od:label "对外采购金额（含税）" ;
            od:name "purchaseAmount" ;
            od:required true ;
            od:unique false ],
        [ a od:Attribute ;
            od:dataType "Enum" ;
            od:label "登记管理状态" ;
            od:name "status" ;
            od:required true ;
            od:unique false ] ;
    od:hasEntity [ a od:Entity ;
            od:alias "PaymentStage" ;
            od:cardinality "ONE_OR_MORE" ;
            od:hasAttribute [ a od:Attribute ;
                    od:dataType "String" ;
                    od:label "付款阶段名称" ;
                    od:name "stageName" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "String" ;
                    od:label "付款阶段编号" ;
                    od:name "stageId" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "Enum" ;
                    od:label "阶段开票状态" ;
                    od:name "invoiceStatus" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "Money" ;
                    od:label "阶段应付金额" ;
                    od:name "stageAmount" ;
                    od:required true ;
                    od:unique false ],
                [ a od:Attribute ;
                    od:dataType "Decimal" ;
                    od:label "付款比例（百分比）" ;
                    od:name "payRatio" ;
                    od:required true ;
                    od:unique false ] ;
            od:localId "stageId" ;
            od:name "付款阶段" ] ;
    od:hasInvariant [ a od:Invariant ;
            od:enforcedAt "ON_CREATE" ;
            od:expression "SUM(stages.payRatio) == 100" ;
            od:name "付款比例合计等于100" ;
            od:violationMessage "付款阶段付款比例合计必须等于 100" ],
        [ a od:Invariant ;
            od:enforcedAt "ALWAYS" ;
            od:expression "purchaseAmount <= totalAmount" ;
            od:name "采购金额不超过合同金额" ;
            od:violationMessage "对外采购金额不得大于合同总金额" ] ;
    od:id "AGG-CONTRACT-001" ;
    od:lifecycle "已作废",
        "已归档",
        "已纳入管理",
        "已结清",
        "已驳回",
        "待总经理审批",
        "待财务经理审批",
        "草稿" ;
    od:name "合同" ;
    od:tags "核心域" .

